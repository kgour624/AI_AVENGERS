# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development

# Database
DATABASE_URL=postgres://avengers:avengers_pass@localhost:5432/ai_avengers?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=60

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-minimum-32-chars
# Dev: 480 min (8 hours) = no logout during working session
# Production: change to 15 for security
JWT_ACCESS_EXPIRY_MINUTES=480
JWT_REFRESH_EXPIRY_DAYS=30

# LLM Provider (openrouter | deepseek | anthropic | gemini)
# Can also be changed from Admin Panel > LLM Settings without restart
LLM_PROVIDER=openrouter

# OpenRouter (default multi-model gateway)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct provider keys (optional - only needed if LLM_PROVIDER != openrouter)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Models
LLM_MODEL_CHEAP=deepseek/deepseek-chat
LLM_MODEL_STRONG=anthropic/claude-3-5-sonnet
LLM_MODEL_FAST=google/gemini-flash-1.5

# ML Sidecar
ML_SIDECAR_URL=http://localhost:8001
# 300s (5 min) — bge-base-en-v1.5 on CPU needs ~10s per 25-chunk batch
# Old value of 30s caused timeouts with 100-chunk batches (~40s on CPU)
ML_SIDECAR_TIMEOUT_SECONDS=300

# China Wall
CHINA_WALL_RERANKER_THRESHOLD=0.35
CHINA_WALL_RELAXED_THRESHOLD=0.30
CHINA_WALL_MAX_RETRIES=5
# B6 quality judge (flat path). Absent ENABLED → true; FLOOR default 0.7;
# MAX_QUALITY_RETRIES absent → 1, explicit 0 = score-only no regen.
# CHINA_WALL_QUALITY_JUDGE_ENABLED=true
# CHINA_WALL_QUALITY_FLOOR=0.7
# CHINA_WALL_MAX_QUALITY_RETRIES=1
# B8 claim→evidence verify (flat path). Absent → true; false = kill switch.
# CHINA_WALL_CLAIM_VERIFY_ENABLED=true

# C1 provenance chain. Absent ENABLED → true; false = kill switch.
# SIGNING_KEY is optional — falls back to ENCRYPTION_KEY when empty.
# PROVENANCE_ENABLED=true
# PROVENANCE_SIGNING_KEY=

# C2 expert versioning + drift. Absent ENABLED → true; THRESHOLD default 0.30.
# EXPERT_VERSIONING_ENABLED=true
# EXPERT_DRIFT_THRESHOLD=0.30

# C6 knowledge freshness (migration 032). Absent ENABLED → true; false =
# disable scanner (admin /freshness* return empty). AGE window default 180d.
# FRESHNESS_ENABLED=true
# FRESHNESS_MAX_CORPUS_AGE_DAYS=180

# C7 adversarial debate on high-stakes artifacts (no migration). Absent
# ENABLED → true; false = kill switch (single-pass review only). HOPS default 2.
# DEBATE_ENABLED=true
# DEBATE_MAX_HOPS=2

# C8 bring-your-own-expert (migration 033). Absent ENABLED → true; false =
# staged kill switch (tenant self-register/ingest disabled). Per-tenant
# entitlement is granted by an admin via tenants.settings.allow_byo_expert;
# DEFAULT_MAX is the fallback quota. Requires tenant isolation (C4) enabled.
# BYO_EXPERT_ENABLED=true
# BYO_EXPERT_DEFAULT_MAX=5

# C5 cost/usage analytics + budgets (migration 031). No env needed —
# budgets are managed via GET/PUT /admin/usage/budgets.

# C4 tenant isolation. Absent ENABLED → true; false = kill switch (scopes
# resolve global, no filtering). Mig 030 backfills all rows onto one
# 'default' tenant, so enabling is behaviour-neutral until a 2nd tenant exists.
# TENANT_ISOLATION_ENABLED=true

# C3 eval harness (cmd/eval). Requires a running server + mig 029.
# EVAL_BASE_URL=http://localhost:8080/api/v1
# EVAL_TOKEN=<access_token>
# EVAL_CHAT_ID=<chat-uuid>
# go run ./cmd/eval  → exit 2 on vital failure / score regression

# Context
CONTEXT_MAX_TOKENS=10000
CONTEXT_RECENT_MESSAGES=3
CONTEXT_SEMANTIC_TOP_K=5
CONTEXT_COURSE_CHUNKS_TOP_K=5

# Encryption (for OAuth tokens at rest)
ENCRYPTION_KEY=change-this-to-32-byte-aes-key-here

# Rate Limiting
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_USER=20

# CORS - add your local network IP if accessing from another device on same WiFi
# Example: if your machine IP is 192.168.1.7 and frontend runs on port 3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.7:3000

# Logging
LOG_LEVEL=info

# Self-registration (POST /auth/register).
# false (default) = public registration is disabled; accounts are created by
# an admin from the Admin > Accounts page. Set true to re-enable the form.
SELF_REGISTRATION_ENABLED=false


# Aider
# Where the Go backend reaches the Python Aider wrapper.
AIDER_SERVICE_URL=http://localhost:8082
# Root of the per-workflow git workspaces (must be writable by the api user).
AIDER_WORKSPACE_ROOT=/tmp/ai_avengers_workspaces
# Shared secret for POST /api/v1/llm/proxy.
# aider-service is a process, not a logged-in user, so it authenticates with
# this token instead of a JWT. aider-service must be given the same value.
# Empty = the proxy replies 503 and the implementation/qa phases cannot run.
AIDER_PROXY_TOKEN=change-this-to-a-long-random-string
