# Development Dockerfile — Vite dev server with HMR
# Used by docker-compose.yml (development)
# NOT used in production (use Dockerfile instead)

FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached layer)
# Source code is mounted as volume — not copied here
# npm install works even without package-lock.json
# WHY not npm ci: npm ci requires package-lock.json to exist.
# Once package-lock.json is committed, switch back to npm ci.
COPY package.json package-lock.json* ./
RUN npm install --silent

# Copy application source code into the container
COPY . .

EXPOSE 3000

# --host 0.0.0.0: Listen on all interfaces (required in Docker)
# Without this, Vite only listens on 127.0.0.1 inside container
# and the port mapping 3000:3000 would not work.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
