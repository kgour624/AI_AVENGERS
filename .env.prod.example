# AI Avengers — Production Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to git

# ============================================================
# REQUIRED — Server will not start without these
# ============================================================

# Database
DATABASE_URL=postgres://avengers:CHANGE_ME@postgres:5432/ai_avengers?sslmode=disable
POSTGRES_USER=avengers
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ai_avengers

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — minimum 32 characters, random string
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_HERE_XXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter LLM Gateway
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# Encryption key for OAuth tokens — EXACTLY 32 bytes
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_EXACTLY_XX

# ============================================================
# OPTIONAL — GitHub/GitLab OAuth
# ============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BASE_URL=https://your-domain.com

# ============================================================
# OPTIONAL — Docker Registry
# ============================================================
REGISTRY=ghcr.io
VERSION=latest
