# AI Avengers — Production Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to git

# ============================================================
# REQUIRED — Server will not start without these
# ============================================================

# Database
DATABASE_URL=postgres://avengers:CHANGE_ME@postgres:5432/ai_avengers?sslmode=disable
POSTGRES_USER=avengers
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ai_avengers

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — minimum 32 characters, random string
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_HERE_XXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter LLM Gateway
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# Encryption key for OAuth tokens — EXACTLY 32 bytes
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_EXACTLY_XX

# Shared secret between the api and aider-service containers.
# aider-service sends it as a Bearer token to POST /api/v1/llm/proxy; it is a
# process with no user login, so it cannot present a JWT. Both containers read
# this same variable. If it is empty the proxy replies 503 and the
# implementation/qa phases cannot run.
AIDER_PROXY_TOKEN=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# ============================================================
# OPTIONAL — Account policy
# ============================================================
# false (default) = public self-registration is disabled; an admin creates
# every account (admin / domain_expert / client) from the Admin panel.
SELF_REGISTRATION_ENABLED=false

# ============================================================
# OPTIONAL — GitHub/GitLab OAuth
# ============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BASE_URL=https://your-domain.com

# ============================================================
# OPTIONAL — Docker Registry
# ============================================================
REGISTRY=ghcr.io
VERSION=latest

# ============================================================
# NOTE: DATABASE_URL format
# postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=disable
# In Docker Compose, HOST = 'postgres' (service name)
# Example: postgres://avengers:CHANGE_ME@postgres:5432/ai_avengers?sslmode=disable
# ============================================================
